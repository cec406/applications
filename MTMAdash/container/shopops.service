[Unit]
Description=Shop Ops dashboard (container)
Documentation=https://github.com/cec406/applications/tree/main/MTMAdash
After=network-online.target docker.service
Wants=network-online.target
Requires=docker.service

[Service]
Restart=always
RestartSec=5
TimeoutStartSec=0
# Remove a stale container left over from a previous run.
ExecStartPre=-/usr/bin/docker rm -f shopops
# Edit the image tag / port / volume here as needed.
ExecStart=/usr/bin/docker run --rm --name shopops \
  --publish 4321:4321 \
  --volume shopops-data:/data \
  --env DATA_FILE=/data/db.json \
  ghcr.io/cec406/mtmadash:latest
ExecStop=/usr/bin/docker stop shopops

[Install]
WantedBy=multi-user.target
